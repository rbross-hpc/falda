#!/usr/bin/env bash
#
# falda — CLI front-end for the FALDA hierarchical agent-memory store.
#
# Commands:
#   falda serve [--no-mcp]  Start the unified server: HTTP JSON API + MCP
#                            endpoint + distillation worker, one process, one
#                            shared runtime (uses built dist/ if present, else
#                            falls back to tsx on the TypeScript source).
#                            --no-mcp starts the HTTP API + worker only.
#   falda gateway           Legacy: HTTP API + worker only, no MCP endpoint.
#                            Equivalent to `falda serve --no-mcp`.
#   falda mcp               Legacy: MCP endpoint only, no distillation worker
#                            of its own (nothing drains the shared queue
#                            unless a `falda serve`/`falda gateway` process
#                            elsewhere owns it).
#   falda smoke             Run the offline smoke test.
#   falda build             Compile TypeScript -> dist/.
#   falda health [PORT]     Curl the HTTP API's /healthz endpoint.
#   falda stats [ARGS]      Read-only, offline report of everything under
#                            FALDA_ROOT: tier counts per store, distillation
#                            queue health, recall metrics, layout/config, and
#                            warnings (e.g. dead-lettered jobs, embedding-lock
#                            mismatch). No running server or token needed.
#                            ARGS: --root=DIR --tenant=T --pool=P
#                            --section=stores|queue|recall|layout --json
#   falda reembed [ARGS]    Rebuild dense-vector indexes for every store (or
#                            one --tenant/--pool) using the currently
#                            configured embedder/dim, then update
#                            EMBEDDING.json. Run with the server stopped —
#                            see docs/OPERATIONS.md "Re-embedding after a
#                            model/dimension change".
#                            ARGS: --root=DIR --tenant=T --pool=P
#                            --dry-run --yes
#   falda distill inspect [ARGS]
#                            Read-only report of what distillation actually
#                            decided (not merely whether it ran): extracted
#                            candidates, store/update/merge/skip decisions
#                            with rationale, T2 scene effects, T3 core
#                            regeneration, and heuristic quality warnings.
#                            Never mutates a store. See docs/OPERATIONS.md
#                            "Reviewing distillation quality".
#                            ARGS: --root=DIR --tenant=T --pool=P
#                            --last=N --since=24h|7d --pass=ID
#                            --action=store,update,merge,skip
#                            --status=running|done|failed --random=N
#                            --evidence --verbose --json
#                            --export-fixture=out.json
#   falda show recall [ARGS] View a recall through the RUNNING falda HTTP
#                            server (requires the server up + a bearer
#                            token — unlike stats/distill-inspect, this is
#                            a live authenticated client, not an offline
#                            inspector). With no --query/--topic, shows the
#                            MOST RECENT recall for the tenant/pool,
#                            reconstructed against current memory (not a
#                            byte-faithful replay — see docs/OPERATIONS.md
#                            "Previewing a recall"). --query/--topic fire a
#                            new recall instead.
#                            ARGS: --tenant=T --pool=P --token=TOK --url=BASE
#                            --recall-id=ID --query=STR --topic=ID|SUBSTR
#                            --budget=N --json
#   falda version           Print the package version.
#   falda help              This help.
#
# Environment (see docs/API.md and docs/MCP.md for the full list):
#   FALDA_PORT             HTTP JSON API port (default 8077).
#   FALDA_MCP_PORT         MCP port (default 8079).
#   FALDA_ROOT             Pool root dir (default ./falda-data).
#   FALDA_TOKENS           Canonical token file, shared by HTTP and MCP.
#   FALDA_DIM              Embedding dimensionality (default 768).
#   FALDA_EMBED_BASE_URL   OpenAI-compatible /v1/embeddings base URL.
#   FALDA_EMBED_API_KEY    API key for the embedder (if required).
#   FALDA_EMBED_MODEL      Embedding model id (default nomic-embed-text).
#   FALDA_EMBED_STRICT     "1" makes an unconfigured embedder a startup
#                            FATAL instead of silently using the deterministic
#                            local embedder (default: unset, i.e. permissive).
#   FALDA_LLM_*            Distillation LLM client (base URL/key/model).
#
set -euo pipefail

ROOT=""
# Resolve this script's real location even when invoked via a symlink.
SELF="${BASH_SOURCE[0]}"
while [ -h "$SELF" ]; do
  DIR="$(cd -P "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$DIR/$SELF" ;; esac
done
ROOT="$(cd -P "$(dirname "$SELF")/.." && pwd)"
cd "$ROOT"

PORT="${FALDA_PORT:-8077}"

usage() { sed -n '3,78p' "$0" | sed 's/^# \{0,1\}//'; }

run_node_or_tsx() {
  # $1 = dist target (relative), $2 = src target (relative), remaining = args
  local dist="$1" src="$2"; shift 2
  if [ -f "$dist" ]; then
    exec node "$dist" "$@"
  elif command -v npx >/dev/null 2>&1; then
    exec npx --yes tsx "$src" "$@"
  else
    echo "falda: no build found at $dist and tsx unavailable. Run: falda build" >&2
    exit 1
  fi
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  serve)
    echo "falda: starting unified server on :$PORT (HTTP) / :${FALDA_MCP_PORT:-8079} (MCP) (Ctrl-C to stop)"
    run_node_or_tsx "dist/server.js" "src/server.ts" "$@"
    ;;
  gateway)
    echo "falda: starting HTTP API + worker (no MCP) on :$PORT (Ctrl-C to stop)"
    run_node_or_tsx "dist/gateway.js" "src/gateway.ts" "$@"
    ;;
  mcp)
    echo "falda: starting MCP endpoint on :${FALDA_MCP_PORT:-8079} (Ctrl-C to stop)"
    run_node_or_tsx "dist/mcp.js" "src/mcp.ts" "$@"
    ;;
  smoke)
    exec npm run --silent smoke
    ;;
  build)
    exec npm run --silent build
    ;;
  health)
    p="${1:-$PORT}"
    curl -fsS "http://localhost:${p}/healthz" && echo
    ;;
  stats)
    run_node_or_tsx "dist/stats.js" "src/stats.ts" "$@"
    ;;
  reembed)
    run_node_or_tsx "dist/reembed.js" "src/reembed.ts" "$@"
    ;;
  distill)
    sub="${1:-}"; shift || true
    case "$sub" in
      inspect)
        run_node_or_tsx "dist/inspect/cli.js" "src/inspect/cli.ts" "$@"
        ;;
      ""|help|--help|-h)
        echo "falda distill: subcommands: inspect" >&2
        exit 1
        ;;
      *)
        echo "falda distill: unknown subcommand '$sub' (try: falda distill inspect)" >&2
        exit 1
        ;;
    esac
    ;;
  show)
    sub="${1:-}"; shift || true
    case "$sub" in
      recall)
        run_node_or_tsx "dist/show/recall.js" "src/show/recall.ts" "$@"
        ;;
      ""|help|--help|-h)
        echo "falda show: subcommands: recall" >&2
        exit 1
        ;;
      *)
        echo "falda show: unknown subcommand '$sub' (try: falda show recall)" >&2
        exit 1
        ;;
    esac
    ;;
  version|--version|-v)
    node -p "require('$ROOT/package.json').version"
    ;;
  help|--help|-h|"")
    usage
    ;;
  *)
    echo "falda: unknown command '$cmd' (try: falda help)" >&2
    exit 1
    ;;
esac
